{
  "name": "stub-desktop",
  "productName": "Stub",
  "version": "1.1.0",
  "description": "Stub for Windows: budget one paycheck at a time",
  "main": "main.js",
  "author": "Stub contributors",
  "license": "MIT",
  "homepage": "https://github.com/picovrfbt/Stub",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.picovrfbt.stub",
    "productName": "Stub",
    "files": ["main.js", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Stub-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Stub"
    }
  }
}
